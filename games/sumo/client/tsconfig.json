{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@sumo/shared": ["../shared/src/index.ts"],
      "@sumo/shared/*": ["../shared/src/*"],
      "@platform/shared": ["../../../platform/shared/src/index.ts"],
      "@platform/shared/*": ["../../../platform/shared/src/*"],
      "@platform/sdk": ["../../../platform/sdk/src/index.ts"],
      "@platform/sdk/*": ["../../../platform/sdk/src/*"],
      "@platform/engine": ["../../../platform/engine/src/index.ts"],
      "@platform/engine/*": ["../../../platform/engine/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
