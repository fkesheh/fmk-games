{
  "name": "fps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w @fps/server\" \"npm run dev -w @fps/client\"",
    "build": "npm run build -w @fps/client && npm run build -w @fps/server",
    "start": "npm run start -w @fps/server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "puppeteer": "25.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
