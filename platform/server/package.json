{
  "name": "@platform/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:ws --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bank/server": "0.0.0",
    "@fps/server": "0.0.0",
    "@kart/server": "0.0.0",
    "@platform/shared": "0.0.0",
    "@rift/server": "0.0.0",
    "@wordbomb/server": "0.0.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1"
  }
}
